# Optional: copy this file to .env and change the settings you need.
# No settings file is needed for http://localhost:8766.
# Sign in with Immich in the browser; do not put credentials here.

# The browser URL defaults to http://localhost:<PEOPLE_WORKBENCH_PORT>.
# Set an explicit URL for a different hostname or an HTTPS reverse proxy.
# PEOPLE_WORKBENCH_PUBLIC_URL=https://people.example.net
PEOPLE_WORKBENCH_BIND_IP=127.0.0.1
PEOPLE_WORKBENCH_PORT=8766
PEOPLE_WORKBENCH_TRUSTED_PROXIES=

# Optional initial Immich URL in the connection form (saved browser URLs win).
# PEOPLE_WORKBENCH_IMMICH_URL=https://photos.example.com

# Set a unique project name to run a separate installation with its own state.
# COMPOSE_PROJECT_NAME=people-workbench-other
