# Copy to .env.docker and use docker compose --env-file .env.docker ...
# These are deployment settings only. Sign in with Immich in the browser.
PEOPLE_WORKBENCH_PUBLIC_URL=http://localhost:8766
PEOPLE_WORKBENCH_BIND_IP=127.0.0.1
PEOPLE_WORKBENCH_PORT=8766
PEOPLE_WORKBENCH_TRUSTED_PROXIES=
