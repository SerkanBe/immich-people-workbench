# Legacy settings template for commands using --env-file .env.docker.
# New installations can use .env.example; localhost needs no settings file.
# These are deployment settings only. Sign in with Immich in the browser.
PEOPLE_WORKBENCH_PUBLIC_URL=http://localhost:8766
PEOPLE_WORKBENCH_BIND_IP=127.0.0.1
PEOPLE_WORKBENCH_PORT=8766
PEOPLE_WORKBENCH_TRUSTED_PROXIES=
# For published installations, pin a released version once images are available:
# PEOPLE_WORKBENCH_IMAGE=ghcr.io/serkanbe/immich-people-workbench:0.1.0
